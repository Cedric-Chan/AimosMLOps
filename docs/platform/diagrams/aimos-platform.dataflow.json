  "cards": [
    {
      "dot": "cyan",
      "title": "模型交付主链",
      "items": [
        "DS GitLab 实验代码经 MLflow 进入 Model Experiment，Run 在 Ray 集群分布式执行",
        "产物 / 指标 / 日志统一落 S3，Run SUCCESS 后注册 Build 并发布为在线推理服务"
      ]
    },
    {
      "dot": "emerald",
      "title": "特征离在线双流",
      "items": [
        "离线流：Hive ODS 元数据 T+1 同步为 DataSource，经 FS→TF→FG 组装，WideTable 以 Point-in-Time Join 产出训练集",
        "在线流：Kafka 经上游 Flink 写入 HBase / Redis，FeatureSource 取数后由 FG 层映射为一致口径的在线特征"
      ]
    },
    {
      "dot": "amber",
      "title": "平台边界",
      "items": [
        "上游数据准备（Flink 写 HBase、Hive 入湖）不属本平台",
        "训练数据为有权限的任意 Hive 表（含 WideTable 产物），与特征平台松耦合"
      ]
    }
  ]
}