  "cards": [
    {
      "dot": "emerald",
      "title": "离在线双流",
      "items": [
        "离线流：Hive ODS 经五层组装为 WideTable 训练集（Point-in-Time Join 落 Hive）",
        "在线流：Kafka / Hive 经上游写入 HBase / Redis，FG 层映射为一致口径在线特征"
      ]
    },
    {
      "dot": "cyan",
      "title": "特征出口",
      "items": [
        "FeatureGroup 为对外唯一出口：训练经 WideTable、在线经 FG Serving 整包消费",
        "FeatureMap 平铺 FG 全部 Feature，提供最细特征粒度检索与 Feature Cart"
      ]
    },
    {
      "dot": "amber",
      "title": "平台边界",
      "items": [
        "上游数据准备（T+1 导入 / Flink 写入）不属平台；FG 特征数据只读",
        "训练与 Serving 绑定同一 Transformer Version，由 FG 层保障一致性"
      ]
    }
  ]
