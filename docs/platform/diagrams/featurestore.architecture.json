  "cards": [
    {
      "dot": "cyan",
      "title": "五层组装",
      "items": [
        "DataSource → FeatureSource → Transformation → FeatureGroup → FeatureMap 五层组装，WideTable 为消费层",
        "FG = 1 FeatureSource + 1 Transformer Version，产出该版本全部 Fine Feature"
      ]
    },
    {
      "dot": "emerald",
      "title": "离在线一致",
      "items": [
        "训练与 Serving 绑定同一 Transformer Version，由 FG 层保障一致性，避免 Skew",
        "训练经 WideTable（Point-in-Time Join）落 Hive；在线经 FG Serving 整包消费"
      ]
    },
    {
      "dot": "amber",
      "title": "平台边界",
      "items": [
        "FG 特征数据只读，摄入由上游管道完成；DataSource 元数据自外部平台 T+1 同步",
        "HBase / Redis / GraphDB 经内置函数访问；gRPC 在线接口由平台 BE 外调执行"
      ]
    }
  ]
